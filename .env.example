# ==============================================================================
# WAAK Storefront (Vite + React) - Environment Configuration Template
# ==============================================================================
# In Vite, variables exposed to the client MUST be prefixed with VITE_
# ==============================================================================

# Backend API Gateway URL
# Local dev: http://localhost:9000
# Staging: https://api.staging.waak.in
# Production: https://api.waak.in
VITE_API_URL=http://localhost:9000

# Razorpay Test Key ID (public test key for client-side modal)
# Must start with rzp_test_ for staging/testing
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_test_key_id
