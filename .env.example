# ==============================================================================
# WAAK Storefront (Vite + React) - Environment Configuration Template
# ==============================================================================
# In Vite, variables exposed to the client MUST be prefixed with VITE_
# ==============================================================================

# Backend API Gateway URL
# Local dev: http://localhost:9000
# Staging: https://api.staging.waak.in
# Production: https://api.waak.in
VITE_API_URL=http://localhost:9000

# Razorpay Test Key ID (public test key for client-side modal)
# Must start with rzp_test_ for staging/testing
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_test_key_id

# WhatsApp Business Concierge Number (E.164 international format)
# Client supplied proposed official number: +91 98217 07031 (normalized: 919821707031)
# Leave empty or unset in staging/dev until business authorization is formally confirmed.
# When empty, missing, or invalid, WhatsAppInquiryButton renders null (zero DOM presence).
VITE_WHATSAPP_NUMBER=

# BodhX AI Chat Widget Configuration
# Platform: BodhX AI (https://bodhx.ai)
# Script embed: https://bodhx.ai/embed/widget.js
# API base endpoint: https://api.bodhx.ai/api1
# Defaults to disabled (false). Set to true only once the client supplies a regenerated token.
# Security notice: Never commit active production tokens or administrative credentials.
VITE_BODHX_WIDGET_ENABLED=false
VITE_BODHX_WIDGET_TOKEN=
VITE_BODHX_API_BASE=https://api.bodhx.ai/api1
