# ==============================================================================
# WAAK Storefront - Production/Staging Dockerfile (Multi-Stage Build)
# ==============================================================================

# Stage 1: Build & Bundle Storefront Assets
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json tsconfig*.json vite.config.ts index.html ./
RUN npm ci

COPY public/ ./public/
COPY src/ ./src/

# Build optimized static production bundle
RUN npm run build

# Stage 2: High-Performance Lightweight Nginx Web Server
FROM nginx:alpine AS runner

# Remove default nginx webpage
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with security headers & SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
