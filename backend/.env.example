# ==============================================================================
# WAAK Occasionwear Commerce Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with environment-specific values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Node Environment ('development', 'staging', 'production')
NODE_ENV=development

# Server Port
PORT=9000

# PostgreSQL Connection String
# Local dev default: postgres://waak_admin:waak_secret_2026@localhost:5432/waak_commerce
# Staging/Prod: Use SSL and managed connection string from AWS RDS / Google Cloud SQL
DATABASE_URL=postgres://waak_admin:your_secure_db_password@localhost:5432/waak_commerce

# Redis Connection URL (Optional for local dev, recommended for staging/production)
# Used for shared rate-limiting across multi-container instances
REDIS_URL=redis://localhost:6379

# JWT Secret for Customer & Admin Session Tokens
# Minimum 32 random characters required in staging and production
JWT_SECRET=replace_with_a_high_entropy_random_32_character_secret_string

# Allowed CORS Origins (comma-separated if multiple)
# Local: http://localhost:5173
# Staging: https://staging.waak.in
# Production: https://waak.in,https://www.waak.in
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# Razorpay Payment Gateway (Test Sandbox Mode)
# ==============================================================================
# Test mode key IDs start with 'rzp_test_'. Live mode keys start with 'rzp_live_'.
# NOTE: Keep in test mode ('rzp_test_') throughout Phase 2.2 staging preparation.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Allow Mock Payment Signatures (strictly false in staging/production)
# Set to 'true' only for automated local integration tests
ALLOW_MOCK_PAYMENTS=false

# ==============================================================================
# Atelier Admin Operations Console
# ==============================================================================
ADMIN_EMAIL=atelier@waak.in
# Default password 'waakAdmin2026!' is strictly rejected when NODE_ENV=production or staging
ADMIN_PASSWORD=replace_with_strong_unique_admin_password
